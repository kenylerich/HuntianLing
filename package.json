{
  "name": "@kenylerich/dsh-huntianling",
  "version": "0.0.0",
  "private": true,
  "description": "HuntianLing — a DeepSeek Harness plugin that delivers a vibe-coding development environment with Planner, Generator, and Evaluator Agents, engineering methods, and a standard development board.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.21.0",
  "files": [
    "lib",
    "cordis.yml",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./host": {
      "types": "./lib/host/plugin.d.ts",
      "default": "./lib/host/plugin.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.src.json",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "clean": "rm -rf lib *.tsbuildinfo",
    "test": "node --test test/unit/*.test.mjs",
    "test:docs": "node scripts/verify-doc-bilingual.mjs",
    "doc-sync": "node scripts/verify-doc-bilingual.mjs",
    "doc-sync:write": "node scripts/verify-doc-bilingual.mjs --write",
    "self-harness:validate": "node .agents/skills/huntianling-self-harness/validate.mjs",
    "self-harness:loop": "node .agents/skills/huntianling-self-harness/repair-loop.mjs",
    "test:e2e": "node scripts/plugin-e2e.mjs",
    "test:e2e:customer": "node scripts/customer-e2e.mjs",
    "lint": "eslint src scripts test eslint.config.mjs --max-warnings 0",
    "hygiene": "node scripts/hygiene.mjs",
    "duplication": "jscpd src --threshold 0 --reporters console,json --output output/verification/duplication",
    "test:coverage": "node scripts/coverage.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jscpd": "^5.2.0",
    "publint": "^0.3.24",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
